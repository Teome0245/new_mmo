[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/inventory_panel.gd" id="1_inv"]
[ext_resource type="Theme" path="res://themes/prime_ui.tres" id="2_theme"]

[node name="InventoryPanel" type="PanelContainer"]
visible = false
anchors_preset = 4
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = 24.0
offset_top = -150.0
offset_right = 320.0
offset_bottom = 150.0
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_inv")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "Inventaire"

[node name="Weight" type="Label" parent="VBox/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "7 / 40"

[node name="Hint" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
text = "I fermer · stub local"

[node name="Grid" type="GridContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/h_separation = 5
theme_override_constants/v_separation = 5
columns = 5
